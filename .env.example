# ─── Database ────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
# Options: Railway, Supabase, Neon, or self-hosted
DATABASE_URL="postgresql://user:password@localhost:5432/capelli_cs_coach"

# ─── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI / OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
# Model to use for analysis (gpt-4o recommended, gpt-4o-mini for lower cost)
OPENAI_MODEL="gpt-4o"
# Embedding model
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ─── File Storage ─────────────────────────────────────────────
# Local uploads folder (relative to project root)
UPLOAD_DIR="./uploads"
# Max file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# ─── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Capelli CS Coach"
NODE_ENV="development"

# ─── Optional: Redis for caching ──────────────────────────────
# REDIS_URL="redis://localhost:6379"
