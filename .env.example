# ─── Copy to .env for local dev. In production (Vercel), set these in the
#     Project → Settings → Environment Variables dashboard. NEVER commit real keys. ───

# Database — Supabase PostgreSQL (pgvector).
# DATABASE_URL: app runtime → Transaction Pooler (port 6543) so serverless
#   functions don't exhaust connections. Keep the pgbouncer params.
#   connection_limit gives each instance a small pool (pages run several queries
#   in parallel); pool_timeout adds headroom for cold starts.
# DIRECT_URL: migrations/introspection → Session Pooler or direct (port 5432).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication (NextAuth)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret"
# Local: http://localhost:4000  |  Production: your Vercel URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:4000"

# ─── AI Providers ───────────────────────────────────────────────────────────
# Chat generation: Cloudflare Workers AI (Groq free tier has a 6k tokens/min cap).
AI_CHAT_PROVIDER="cloudflare"
CLOUDFLARE_CHAT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# Leave AI_CHAT_MODEL unset so each provider uses its own default.
# AI_CHAT_MODEL=""

# Embeddings: Cloudflare BGE (768-dim, matches the vector(768) schema).
AI_EMBEDDING_PROVIDER="cloudflare"
AI_EMBEDDING_MODEL="@cf/baai/bge-base-en-v1.5"

# Cloudflare Workers AI credentials (used for both chat + embeddings)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Optional Groq fallback (only if AI_CHAT_PROVIDER="groq")
GROQ_API_KEY="your-groq-api-key"

# ─── File storage ─────────────────────────────────────────────────────────────
# Leave UPLOAD_DIR unset in production — it defaults to the OS temp dir, which is
# the only writable path on Vercel. (Temp storage is ephemeral; for reliable doc
# ingestion in prod, run `npm run kb:ingest` against the prod DB.)
# UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# ─── App config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Capelli CS Coach"
